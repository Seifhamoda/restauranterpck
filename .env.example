# ====================================================================
# SMART CENTRAL KITCHEN ERP - ENVIRONMENT CONFIGURATION
# ====================================================================

# Port for the Express backend server (default: 8080)
PORT=8080

# Administrator account configuration (initial setup)
# If ADMIN_PASSWORD is left blank, a secure random one-time password
# is generated and logged to the server console upon first initialization.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_password

# Secret API key for external B2B integration / machine-to-machine requests
# Leave empty if you do not use machine-to-machine B2B integrations.
API_SECRET_KEY=

# Comma-separated list of allowed origins for CORS (default: localhost / same-origin)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000
